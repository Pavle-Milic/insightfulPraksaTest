# Copy this file to ".env" to change the defaults. Every variable is optional.

PORT=8080
MONGODB_URI=mongodb://localhost:27017/Insightful_Test

# HS256 secret, at least 32 characters. Always set your own outside local development.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=60

# Mock data seeding on startup:
#   SEED_ENABLED - run the seeder when the app starts
#   SEED_RESET   - wipe both collections and reseed even if they already contain data
SEED_ENABLED=true
SEED_RESET=false
